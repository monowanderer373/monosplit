# Copy this file to .env.local and fill in your Supabase credentials
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional privacy-safe error reporting. Leave DSN blank to disable Sentry.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=local
VITE_SENTRY_RELEASE=tabby-tally@0.0.0
